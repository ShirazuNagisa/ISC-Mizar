<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleName</key><string>ISC Mizar</string>
<key>CFBundleDisplayName</key><string>Mizar</string>
<key>CFBundleIdentifier</key><string>app.isc.mizar.watchkitapp</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.2.1</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<!-- 出口合规：同手机那一份 —— 只有标准的 HTTPS 与 Keychain，
     都属于豁免，因此不必每次上传都回答一次加密问询。 -->
<key>ITSAppUsesNonExemptEncryption</key><false/>
<key>WKApplication</key><true/>
<key>WKCompanionAppBundleIdentifier</key><string>app.isc.mizar</string>
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>CFBundleLocalizations</key><array><string>en</string><string>zh-Hans</string></array>
<!-- 本地网络：手表在**同一局域网内**直连服务端时，watchOS 要求这个
     权限。走公网地址时不经过它 —— 这句只说局域网那一条路。 -->
<key>NSLocalNetworkUsageDescription</key>
<string>在局域网内直连你的 Phecda 服务端以查看状态。</string>
<key>NSBonjourServices</key><array>
  <string>_isc._tcp</string>
</array>
</dict></plist>
