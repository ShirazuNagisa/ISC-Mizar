<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleName</key><string>ISC Mizar</string>
<key>CFBundleDisplayName</key><string>ISC Mizar</string>
<key>CFBundleIdentifier</key><string>app.isc.mizar</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.2.1</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<!-- 出口合规：本应用不使用**非豁免**的加密。
     它用到的只有 HTTPS（URLSession 提供的标准 TLS）与 Keychain ——
     两者都在豁免范围内（TLS 是"标准加密"，Keychain 是操作系统服务，
     不涉及自研或非标准密码学）。少了这一条，每次上传 TestFlight 都会
     被问一遍"你的应用用了加密吗"，而答案永远是同一个。 -->
<key>ITSAppUsesNonExemptEncryption</key><false/>
<key>LSRequiresIPhoneOS</key><true/>
<key>UILaunchScreen</key><dict/>
<!-- 四个方向一个都不能少。App Store 的上传校验**拒绝**缺任何一个的包：
     ITMS-90474「you need to include all of the … orientations to support
     iPad multitasking」，而它看的就是这一个键 —— 报错里会把这三个取值
     原样引出来（实测被拒过一次，就是这一条）。

     倒置竖屏在新款 iPhone 上是空操作：Face ID 机型不提供那个方向，所以
     它不会真的让 iPhone 界面翻转，存在的意义只是满足 iPad 的多任务要求
     （`UIRequiresFullScreen` 那条退路已被 Apple 废弃，见 TN3192）。
     想让应用只支持 iPhone 的话，正解是把工程里的 TARGETED_DEVICE_FAMILY
     改成 1，而不是把这一条删掉。 -->
<key>UISupportedInterfaceOrientations</key><array>
  <string>UIInterfaceOrientationPortrait</string>
  <string>UIInterfaceOrientationPortraitUpsideDown</string>
  <string>UIInterfaceOrientationLandscapeLeft</string>
  <string>UIInterfaceOrientationLandscapeRight</string>
</array>
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>CFBundleLocalizations</key><array><string>en</string><string>zh-Hans</string></array>
<!-- 相机：扫码配对。描述会显示在权限弹窗上。 -->
<key>NSCameraUsageDescription</key>
<string>扫描 Phecda 上的配对二维码，用于连接你的服务端。</string>
<!-- 本地网络：手机在**同一局域网内**直连服务端时，iOS 要求这个权限。
     没有这一条，第一次请求会静默失败（而错误信息完全不指向权限）。
     走公网地址（服务端的公网域名 / IPv6）时不经过这个权限 —— 所以
     这句说明只讲局域网那一条路，不代表 Mizar 只能用局域网。 -->
<key>NSLocalNetworkUsageDescription</key>
<string>在局域网内直连你的 Phecda 服务端以查看状态与资源占用。</string>
<key>NSBonjourServices</key><array>
  <string>_isc._tcp</string>
</array>
<!-- 这个应用只连自签证书的 HTTPS 服务端，不上任何公网站点。
     ATS 约束的是 TLS 版本与密码套件（我们满足 TLS 1.2+），
     证书的信任评估由 URLSession 的挑战回调接管（见 SpkiPinning）。 -->
<key>WKAppBundleIdentifier</key><string>app.isc.mizar.watchkitapp</string>
<!-- 后台刷新与远程通知。fetch 是兜底轮询，remote-notification 让系统
     在收到静默推送时唤醒应用（有配额，不能当主力用）。 -->
<key>UIBackgroundModes</key><array>
  <string>fetch</string>
  <string>remote-notification</string>
</array>
<!-- 这一条必须与 BackgroundRefresh.identifier 逐字一致：不一致时系统
     **静默拒绝**注册，而症状是"后台刷新永远不跑"，没有任何错误信息。 -->
<key>BGTaskSchedulerPermittedIdentifiers</key><array>
  <string>app.isc.mizar.refresh</string>
</array>
<!-- 配对链接。`isc-remote://pair?d=<base64url payload>` 正是 MizarKit
     里 PairingPayload.link() 产出的那一种 —— 也就是说**同一条链接**
     既能被复制粘贴，也能直接点开。
     它带来两件真实的事：Phecda 可以把链接交给系统去打开（不必让用户
     对着屏幕扫），以及验收脚本能在模拟器上把整条配对链路跑一遍。 -->
<key>CFBundleURLTypes</key><array><dict>
  <key>CFBundleURLName</key><string>app.isc.mizar.pairing</string>
  <key>CFBundleURLSchemes</key><array><string>isc-remote</string></array>
</dict></array>
</dict></plist>
